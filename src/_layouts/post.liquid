---
layout: default
header: no
footer: no
---

<article class="post-content">
  <header>
    <h1 class="post-title">{{ page.title }}</h1>
    <div class="post-meta">
      <span class="emoji" dir="ltr" title="{{ page.date }}">📆</span>
      {{ page.date | jdate_html: "%A %d %b %Y"}}
      &nbsp;توسط
      <a href="{{ '/' | relative_url}}">{{ site.title }}</a>
    </div>
  </header>
  {{ content | toc }}
</article>
<footer class="post-meta">
    {% for tag in page.tags %}

      <a rel="tag" href="{{ tag | tag_url  }}"><span class="emoji">🏷️</span> {{tag}}</a>
    {% endfor %}

    <span class="emoji">📜</span>
    {% assign slash = site.source | slice: 0 %}
    {% if slash == '/' %}
    <a href="https://raw.githubusercontent.com/{{site.github.username}}/{{site.github.repository}}/master/{{ page.path }}">سورس</a>
    {% else %}
    <a href="https://raw.githubusercontent.com/{{site.github.username}}/{{site.github.repository}}/master/{{site.source}}/{{page.path}}">سورس</a>
    {% endif %}
</footer>

{% if page.related_posts.size >= 1 %}
    <aside id="related-posts">
      <h3>مطالب مرتبط</h3>
      <ul>
        {% for related_post in page.related_posts %}
          <li><a href="{{ related_post.url | relative_url }}">{{ related_post.title }}</a></li>
        {% endfor %}
        </ul>
    </aside>
{% endif %}
<aside>
<nav class="pagination">
  {% if page.next %}
    <a href="{{ page.next.url | relative_url }}" title="j">{{ page.next.title }} →</a>
  {% endif %}
  {% if page.previous %}
    <a href="{{ page.previous.url | relative_url }}" title="k">← {{ page.previous.title }}</a>
  {% endif %}
</nav>
</aside>

{% include comments_section.liquid %}

<div class="dingbat">
  ❦
</div>
