---
layout: base
---
<article class="post-content">
  <header>
    <h1 class="post-title">{{ page.title }}</h1>
  </header>

  <p>{{ page.description | markdownify | remove: '<p>' | remove: '</p>' }}</p>

  <h4>زبان برنامه‌نویسی</h4>
  <p>با کمک <code>{{ page.language }}</code> نوشته شده است.</p>

  {% if page.data_sources %}
  <h4>داده‌های مورد استفاده</h4>
  <ul>
    {% for source in page.data_sources %}
      <li>
        {% if source.url %}
          <a href="{{ source.url }}">{{ source.description }}</a>
        {% else %}
          {{ source.description }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if page.website %}
  <h4>نصب</h4>
  <p><a href="{{ page.website }}">{{ page.website }}</a></p>
  {% endif %}

  <h4>ریپازیتوری</h4>
  <p><a href="{{ page.repository.url }}">{{ page.repository.url }}</a></p>

  <h4>گزارش مشکلات و پیشنهادات</h4>
  <p><a href="{{ page.repository.tracker }}">{{ page.repository.tracker }}</a></p>

</article>
