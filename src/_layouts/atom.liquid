<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xml" href="{{ 'feed.xsl' | absolute_url }}" ?>

<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fa">
  {% if page.alternate %}<link rel="alternate" type="text/html" href="{{ site.url }}" hreflang="fa" />{% endif %}
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}" />

  <id>{% if site.atom_feed_id %}{{ site.atom_feed_id }}{% else %}{{ '/' | absolute_url | xml_escape }}{% endif %}</id>
  <title type="text" xml:lang="fa">{{ page.feed_title | default: site.title | xml_escape }}</title>
  {% if page.feed_suffix %}<subtitle>{{ page.feed_suffix | xml_escape }}</subtitle>{% endif %}
  {% if page.feed_footnote %}<generator>{{ page.feed_footnote | xml_escape }}</generator>{% endif %}
  <updated>{{ site.time | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
  <rights>{{ site.copyright | xml_escape }}</rights>

  {% if page.feed_author %}
  <author>
    <name>{{ site.author | xml_escape }}</name>
    <email>{{ site.email | xml_escape }}</email>
    <uri>{{ site.url | xml_escape }}</uri>
  </author>
  {% endif %}

{{ content }}
</feed>
