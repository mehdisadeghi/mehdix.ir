<footer id="site-footer">
  <p>
  {% if site.avatar %}
    <img id="footer-gravatar" src="{{ 'assets/img/me.png' | relative_url }}" alt="">
  {% endif %}
  {{ site.long_description }}
  </p>

  <div class="social-media-list">
    {% if site.github.username %}
    <div>
    <i class="fab fa-github"></i>
    <a href="https://github.com/{{ site.github.username }}">
      <span>پروژه‌ها</span>
    </a>
    </div>
    {% endif %}
    <div>
    <i class="fas fa-rss"></i>
    <a href="{{ 'feed.xml' | absolute_url }}">
    <span>خوراک</span></a>
    </div>
    {% if site.email %}
    <div>
      <i class="fas fa-envelope-open"></i>
      <a href="mailto:{{ site.email }}">
      <span>تماس</span></a></div>
    {% endif %}
  </div>

  <div id="footer-extra">
    <small id="footer-license">
      <i class="fab fa-creative-commons"></i>
      مطالب این وبلاگ تحت مجوز
      <a rel="license" href="http://creativecommons.org/licenses/by/4.0/deed.fa">
        کریتیو کامنز اتریبیوشن ۴.۰ اینترنشنال
      </a>قرار دارد.
    </small>
    <a href="{{ 'feed.xml' | absolute_url }}"><img class="feed" src="{{ 'assets/img/feed.svg' | relative_url }}" alt="فید مقالات" title="فید مقالات"/></a>
    <a id="footer-atom" href="https://validator.w3.org/feed/check.cgi?url={{ 'feed.xml' | absolute_url }}"><img src="{{ 'assets/img/valid-atom.png' | relative_url }}" alt="[Valid Atom 1.0]" title="Validate my Atom 1.0 feed" /></a>
  </div>

  <small id="footer-build-time">Site generated on {{ site.time | date_to_rfc822 }}</small>
</footer>
